{
  "name": "chatbot",
  "version": "3.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "biome check app/api app/globals.css app/layout.tsx app/page.tsx components/brain-scene.tsx components/principles-council.tsx lib/principles-graph.ts",
    "typecheck": "tsc --noEmit",
    "ragflow:bootstrap": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap-ragflow.ps1",
    "ragflow:seed": "node scripts/seed-ragflow.mjs",
    "brain:extract": "node scripts/extract-brain-asset.mjs",
    "council:verify": "pnpm exec tsx scripts/verify-council-v1.ts",
    "release:wait": "pnpm exec tsx scripts/wait-release-health.ts",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm exec tsx lib/db/migrate.ts",
    "db:verify": "node scripts/verify-foundation-schema.mjs && node scripts/verify-judgment-loop-schema.mjs && node scripts/verify-learning-loop-schema.mjs",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:check": "drizzle-kit check",
    "db:up": "drizzle-kit up",
    "test": "pnpm exec playwright test",
    "test:e2e": "pnpm exec playwright test tests/e2e/principles-smoke.test.ts tests/e2e/judgment-loop.test.ts tests/e2e/personal-brain.test.ts tests/e2e/learning-loop.test.ts tests/e2e/journal-reflection.test.ts",
    "verify": "pnpm check && pnpm typecheck && pnpm council:verify && pnpm db:check && pnpm build"
  },
