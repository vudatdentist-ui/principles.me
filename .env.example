# Canonical environment variable contract for Principles.
# Copy to .env.local for development. Never commit real secrets.

# Runtime identity. Use development | test | staging | production.
APP_ENV=development
APP_VERSION=development

# Internal v1 authentication. Staging/production require auth by default.
INTERNAL_AUTH_REQUIRED=false
# Comma-separated approved account emails. Each email must also exist in the
# User table with a password provisioned by scripts/provision-internal-user.ts.
INTERNAL_AUTH_EMAILS=

# Server-only application infrastructure.
AUTH_SECRET=
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/principles
BLOB_READ_WRITE_TOKEN=
REDIS_URL=

# DeepSeek reasoning layer. Server-only.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# RAGFlow runs as a separate service. Server-only credentials.
# Staging must point RAGFLOW_DATASET_IDS at the dedicated test dataset.
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=
RAGFLOW_DATASET_IDS=
RAGFLOW_DOCUMENT_DIR=./data/source
RAGFLOW_TOP_K=10
RAGFLOW_MAX_REFERENCES=14
RAGFLOW_SIMILARITY_THRESHOLD=0.15
RAGFLOW_VECTOR_SIMILARITY_WEIGHT=0.7
RAGFLOW_TIMEOUT_MS=10000

# Do not expose AUTH_SECRET, POSTGRES_URL, provider keys, tokens, or RAGFlow
# credentials through NEXT_PUBLIC_* variables. NEXT_PUBLIC_* is browser-visible.
