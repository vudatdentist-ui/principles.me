# Secure personal + organization workspace baseline.

APP_ORIGIN=http://localhost:3000
# Account creation is open unless explicitly disabled.
# Legacy AUTH_SIGNUP_MODE=bootstrap is treated as open in Phase 5.
AUTH_SIGNUP_MODE=open
AUTH_ATTEMPTS_PER_15_MINUTES=10
ASK_RATE_LIMIT_PER_HOUR=30
PEOPLE_AI_REQUESTS_PER_HOUR=30

# Transactional email via Brevo. Keep the API key server-side only.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Principles
BREVO_BASE_URL=https://api.brevo.com/v3

# Durable system of record. DATABASE_URL overrides the POSTGRES_* fields when set.
DATABASE_URL=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=principles
POSTGRES_USER=principles
POSTGRES_PASSWORD=principles-local
POSTGRES_POOL_MAX=8

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_TOKENS=2200
DEEPSEEK_TIMEOUT_MS=55000

# RAGFlow remains a separate private-knowledge service.
# Docker production normally uses http://host.docker.internal:9380.
# RAGFLOW_DATASET_IDS are bound to every Personal Workspace while bootstrap
# assignment is enabled, and repair missing bindings for existing workspaces.
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=
RAGFLOW_DATASET_IDS=
RAGFLOW_ASSIGN_BOOTSTRAP_DATASETS=true
RAGFLOW_DOCUMENT_DIR=C:\\Source
RAGFLOW_TOP_K=10
RAGFLOW_KEYWORD_SEARCH=true
RAGFLOW_SIMILARITY_THRESHOLD=0.2
RAGFLOW_VECTOR_SIMILARITY_WEIGHT=0.3
RAGFLOW_TIMEOUT_MS=10000

# Live public knowledge. Modes: auto | always | off.
LIVE_SEARCH_MODE=auto
LIVE_SEARCH_REQUIRED=false
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search
BRAVE_SEARCH_COUNT=5
BRAVE_SEARCH_TIMEOUT_MS=8000
BRAVE_SEARCH_COUNTRY=
BRAVE_SEARCH_LANGUAGE=

# Dedicated authenticated production smoke account. Do not use a primary user password.
SMOKE_EMAIL=
SMOKE_PASSWORD=
