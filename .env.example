# Required for V2 guest sessions, DecisionRun persistence, and review data.
# Use the real production database URL only in .env.production / secret storage.
POSTGRES_URL=postgres://USER:PASSWORD@HOST:5432/DB

AUTH_SECRET=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_TOKENS=1800
DEEPSEEK_TIMEOUT_MS=45000
DEEPSEEK_SYNTHESIS_TIMEOUT_MS=55000

# RAGFlow runs as a separate service. Use the API key and dataset ID from its UI/API.
# Local `pnpm dev` can use http://localhost:9380.
# docker-compose.hostinger.yml must use the VPS host gateway instead:
#   http://host.docker.internal:9380
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=
RAGFLOW_DATASET_IDS=
RAGFLOW_DOCUMENT_DIR=C:\\Users\\Admin\\Desktop\\Source
RAGFLOW_TOP_K=10
RAGFLOW_KEYWORD_SEARCH=true
RAGFLOW_SIMILARITY_THRESHOLD=0.2
RAGFLOW_VECTOR_SIMILARITY_WEIGHT=0.3
RAGFLOW_TIMEOUT_MS=10000

# Optional, explicit web research. The UI never sends web traffic unless enabled.
# Tavily results remain external evidence and are not auto-imported into RAGFlow.
TAVILY_API_KEY=
WEB_RESEARCH_TIMEOUT_MS=12000
